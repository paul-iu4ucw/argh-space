# SVILUPPO IN LOCALE (e Vercel): copia in .env.local e compila.
# Per il server con Docker usa invece deploy/env.example.

AUTH_SECRET=stringa-casuale-lunga-almeno-32-caratteri
NEXT_PUBLIC_WIKI_URL=https://wiki.argh.space
# Google Tag Manager (facoltativo: in produzione, senza questa variabile, usa GTM-NFZ4HSFL; si carica solo dopo il consenso ai cookie)
# NEXT_PUBLIC_GTM_ID=GTM-NFZ4HSFL
NEXT_PUBLIC_SITE_URL=https://argh.space

# Prisma Postgres (connessione diretta per migrazioni/seed, pooled per l'app su Vercel)
DATABASE_URL=postgres://utente:password@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL_POOLED=postgres://utente:password@pooled.db.prisma.io:5432/postgres?sslmode=require
# Con un Postgres sul tuo computer basta la prima, senza la seconda:
# DATABASE_URL=postgres://argh:password@localhost:5432/argh

# Cartella delle foto caricate dall'admin (facoltativa: in sviluppo si usa ./.media)
# MEDIA_DIR=.media

# Email (OVH). SMTP_FROM opzionale: se assente si usa SMTP_USER
SMTP_HOST=host-gestore
SMTP_PORT=25
SMTP_USER=email
SMTP_PASSWORD=password-della-casella
# SMTP_FROM=

# Segreto per i cron (email delle novità e pulizia degli account scaduti)
CRON_SECRET=stringa-casuale-lunga

# Email del proprietario: è l'unica che può creare il primo amministratore da /admin/setup (e che riceve il link di conferma)
ADMIN_EMAIL=proprietario@argh.space

# Sul server: /opt/argh/.env (chmod 600). NON va nel repository.
# Se un valore contiene $ o spazi, mettilo tra apici singoli.
# DATABASE_URL, DATABASE_URL_POOLED e MEDIA_DIR NON vanno messe: le imposta docker-compose.yml.
# NEXT_PUBLIC_* non serve: per il dominio ci sono SITE_URL e WIKI_URL qui sotto.

# Scritti dal deploy, lasciali vuoti la prima volta
IMAGE=
TAG=

# Indirizzi del sito: link nelle email, indirizzo per le stazioni RFI, SEO e cookie condivisi.
# La wiki deve stare su un sottodominio che inizia per "wiki." dello stesso dominio.
SITE_URL=https://argh.space
WIKI_URL=https://wiki.argh.space

# HTTPS con Caddy. Togli la riga se sul server hai già un reverse proxy (poi punta a 127.0.0.1:APP_PORT)
COMPOSE_PROFILES=https
SITE_ADDRESSES='argh.space, wiki.argh.space'
APP_PORT=3000
# Se le porte 80/443 sono di un Caddy in Docker di un altro progetto: togli COMPOSE_PROFILES e attiva queste (DEPLOY.md, punto 2)
# COMPOSE_FILE=docker-compose.yml:proxy.yml
# PROXY_NETWORK=

# openssl rand -hex 24   (solo lettere e numeri: finisce dentro un URL)
POSTGRES_PASSWORD=
# openssl rand -hex 32   Se importi i dati da Vercel, usa LO STESSO valore che avevi là (2FA e link nelle email)
AUTH_SECRET=
# openssl rand -hex 32
CRON_SECRET=

ADMIN_EMAIL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=

BACKUP_KEEP_DAYS=14
